FROM ros:humble-ros-base-jammy
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip python3-colcon-common-extensions ros-humble-vision-msgs \
    ros-humble-launch-testing ros-humble-launch-testing-ament-cmake \
    ros-humble-sensor-msgs-py ros-humble-tf2-ros \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.12.2 /uv /uvx /bin/
ENV VIRTUAL_ENV=/opt/venv UV_PROJECT_ENVIRONMENT=/opt/venv PATH=/opt/venv/bin:$PATH
RUN uv venv /opt/venv --python /usr/bin/python3.10 --system-site-packages
WORKDIR /build
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --extra dev
# Humble tooling constraints: the venv must not carry its own setuptools (image-and-bootstrap.md section 1;
# colcon and --symlink-install use apt's 59.6), and launch_testing's pytest plugin fails to load under pytest 9.
RUN uv pip uninstall setuptools && uv pip install "pytest<9"
